# ==============================================================================
# MS Home Trends - Environment Variables Configuration
# ==============================================================================

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Format: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Database Name (Defaults to "mshometrends")
MONGODB_DB_NAME=mshometrends

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# Application URL
APP_URL=https://ais-dev-u6xk2pbvggwsmbfldmzp7d-164731009787.us-west2.run.app

# Cloudinary Storage Configuration (For Product & Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=mshometrends

# Optional: Frontend API Base URL (Used by Vite client when hosted separately)
VITE_API_BASE_URL=

